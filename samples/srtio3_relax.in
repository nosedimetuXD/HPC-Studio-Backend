&CONTROL
  calculation = 'relax',
  restart_mode = 'from_scratch',
  prefix = 'srtio3',
  outdir = './tmp/',
  pseudo_dir = './pseudo/',
  forc_conv_thr = 1.0d-3,
  etot_conv_thr = 1.0d-4,
  tprnfor = .true.,
  tstress = .true.
/
&SYSTEM
  ibrav = 1,
  celldm(1) = 7.37,
  nat = 5,
  ntyp = 3,
  ecutwfc = 45.0,
  ecutrho = 360.0
/
&ELECTRONS
  conv_thr = 1.0d-8,
  mixing_beta = 0.7,
  diagonalization = 'david'
/
&IONS
  ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
  Sr  87.62   Sr.pbe-spn-kjpaw_psl.1.0.0.UPF
  Ti  47.867  Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
  O   15.999  O.pbe-n-kjpaw_psl.1.0.0.UPF
ATOMIC_POSITIONS (crystal)
  Sr  0.000000000  0.000000000  0.000000000  0 0 0
  Ti  0.500000000  0.500000000  0.500000000  1 1 1
  O   0.500000000  0.500000000  0.000000000  1 1 1
  O   0.500000000  0.000000000  0.500000000  1 1 1
  O   0.000000000  0.500000000  0.500000000  1 1 1
K_POINTS (automatic)
  6 6 6  0 0 0
